import requests
import json
import re
from bs4 import BeautifulSoup
from datetime import datetime
from zoneinfo import ZoneInfo

now = datetime.now(ZoneInfo("Europe/Warsaw"))

date_iso = now.strftime("%Y-%m-%d")

months = [
    "stycznia", "lutego", "marca", "kwietnia",
    "maja", "czerwca", "lipca", "sierpnia",
    "września", "października", "listopada", "grudnia"
]

days = [
    "poniedziałek", "wtorek", "środa", "czwartek",
    "piątek", "sobota", "niedziela"
]

date_pl = (
    f"{days[now.weekday()]}, "
    f"{now.day} {months[now.month - 1]} {now.year}"
)

url = f"https://episkopat.pl/liturgia/{date_iso}"

response = requests.get(
    url,
    headers={"User-Agent": "Mozilla/5.0"},
    timeout=30
)

response.raise_for_status()

soup = BeautifulSoup(response.text, "html.parser")


def clean(text):
    text = " ".join(text.split())
    return text.strip()


def znajdz_sekcje(nazwa):

    wszystkie_naglowki = soup.find_all(["h1", "h2", "h3", "h4", "h5", "h6"])

    start = None

    for heading in wszystkie_naglowki:
        heading_text = clean(heading.get_text(" ", strip=True))
        heading_text = heading_text.rstrip(":")

        if heading_text.lower() == nazwa.lower():
            start = heading
            break

    if start is None:
        return None

    teksty = []

    for element in start.find_all_next():

        # Kończymy na następnym nagłówku
        if element.name in ["h1", "h2", "h3", "h4", "h5", "h6"]:
            break

        if element.name == "p":
            text = clean(element.get_text(" ", strip=True))

            if not text:
                continue

            # Pomijamy elementy techniczne strony
            if "Jeżeli chcesz, aby codzienne czytania" in text:
                break

            if "Copyright ©" in text:
                break

            if "Wygląda na to, że Twoja przeglądarka" in text:
                break

            if text not in teksty:
                teksty.append(text)

    if not teksty:
        return None

    reference = teksty[0]
    text = "\n\n".join(teksty[1:])

    return {
        "reference": reference,
        "text": text
    }


data = {
    "date": date_iso,
    "date_pl": date_pl,

    "firstReading": znajdz_sekcje(
        "Pierwsze czytanie"
    ),

    "psalm": znajdz_sekcje(
        "Psalm responsoryjny"
    ),

    "secondReading": znajdz_sekcje(
        "Drugie czytanie"
    ),

    "gospel": znajdz_sekcje(
        "Ewangelia"
    )
}


with open("readings.json", "w", encoding="utf-8") as file:
    json.dump(
        data,
        file,
        ensure_ascii=False,
        indent=2
    )

print("Zapisano czytania dla:", date_iso)
